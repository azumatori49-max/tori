EXPO_PUBLIC_AWS_REGION=ap-northeast-1
EXPO_PUBLIC_AWS_ACCESS_KEY_ID=
EXPO_PUBLIC_AWS_SECRET_ACCESS_KEY=

# キャリブレーション用ログ送信先 (任意)。Supabase REST、Webhook、自前 Lambda など。
# 設定しない場合は端末のコンソールにのみログ出力される。
EXPO_PUBLIC_LOG_ENDPOINT=

# 店舗識別子 (任意)。ログに含まれて店舗別に集計可能になる。
# 例: TR001, TR-SHIBUYA, ginza-1f
EXPO_PUBLIC_STORE_ID=
