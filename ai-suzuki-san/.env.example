# ===== サーバー =====
PORT=3000

# ===== Claude API =====
ANTHROPIC_API_KEY=sk-ant-...
# 省略時は claude-opus-4-8
CLAUDE_MODEL=claude-opus-4-8

# ===== 鈴木さん（管理者）=====
# 鈴木さんのLINE UID。Poster管理画面 > 友だち検索 で確認できる "LINE UID"。
# 複数人いる場合はカンマ区切り
ADMIN_LINE_USER_IDS=U1234567890abcdef1234567890abcdef

# ===== LINE Messaging API（送信用・推奨）=====
# LINE Official Account Manager / LINE Developers で発行する長期チャネルアクセストークン
# （Posterに登録したものと同じチャネルのもの）
LINE_CHANNEL_ACCESS_TOKEN=
# チャネルシークレット（Webhook署名検証用）
LINE_CHANNEL_SECRET=

# ===== Poster API（タグ同期・任意）=====
# Poster管理画面でAPIクライアントを作成して取得
POSTER_API_BASE=https://poster.ooo/api
POSTER_CLIENT_ID=
POSTER_CLIENT_SECRET=
# PosterのWebhook署名検証キー（イベントフック利用時）
POSTER_WEBHOOK_KEY=
# 不備対応中の従業員に付けるPosterタグ名（任意・空なら同期しない）
POSTER_TAG_ACTIVE=不備対応中

# ===== リマインド =====
# 従業員が無反応のとき何時間後に催促するか
REMINDER_AFTER_HOURS=48
# 催促の最大回数（超えたら鈴木さんにエスカレーション）
REMINDER_MAX_COUNT=2
