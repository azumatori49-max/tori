# 初期管理者アカウント（未設定の場合は README 記載のデフォルト値で作成されます）
ADMIN_EMAIL=toriyaro17@gmail.com
ADMIN_PASSWORD=toriyaro1

# セッションCookieの署名キー（本番環境では必ずランダムな値を設定してください）
SESSION_SECRET=

# PostgreSQL接続文字列（Supabase / Neon / Vercel Postgres など）
# 設定するとPostgreSQLを使用し、未設定ならローカルのSQLite(data/payment-check.db)を使用します
# 例: DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
