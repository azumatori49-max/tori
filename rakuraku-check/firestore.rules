rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasAppAccess() {
      return request.auth != null
        && request.auth.uid == 'rinten-staff-nov26-v1'
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    match /inspections/{id} {
      allow read, delete: if hasAppAccess();
      allow create, update: if hasAppAccess()
        && request.resource.data.tenantId == 'default';
    }
    match /photos/{id} {
      allow read, delete: if hasAppAccess();
      allow create, update: if hasAppAccess()
        && request.resource.data.tenantId == 'default';
    }
    match /config/{id} {
      allow read, write: if hasAppAccess();
    }
  }
}
