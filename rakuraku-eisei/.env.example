# Firebase 接続情報（src/config.ts に直接書いてもOK。こちらが優先されます）
# Firebase コンソール → プロジェクトの設定 → マイアプリ → SDK の設定と構成 からコピー
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 管理者アカウントのメールアドレス（firestore.rules / storage.rules と一致させる）
VITE_ADMIN_EMAIL=azumatori49@gmail.com
