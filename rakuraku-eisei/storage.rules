rules_version = '2';

// らくらく衛生管理 — Storage セキュリティルール
//
//   - 写真のアップロードは「管理者」または「正しくログインした店舗（自店舗の
//     フォルダのみ）」に限定。入場券（Firestore の storeSessions）を照合する
//   - 画像以外・10MB 超のファイルは拒否
//   - 閲覧はログイン済みユーザーのみ（写真の表示は保存済みのダウンロードURL経由）

service firebase.storage {
  match /b/{bucket}/o {

    // src/config.ts の ADMIN_EMAIL / firestore.rules の isAdmin と揃えること
    function isAdmin() {
      return request.auth != null
        && ('email' in request.auth.token)
        && request.auth.token.email in ['azumatori49@gmail.com'];
    }

    function hasSession(storeKey) {
      return firestore.exists(/databases/(default)/documents/storeSessions/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/storeSessions/$(request.auth.uid)).data.storeKey == storeKey;
    }

    match /photos/{storeKey}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && (isAdmin() || hasSession(storeKey));
    }
  }
}
