# Google Cloud Console で発行した OAuth 2.0 クライアント情報
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# アプリの公開 URL(ローカル開発時は http://localhost:3000)
# Google OAuth のリダイレクト URI には ${APP_URL}/api/auth/callback を登録すること
APP_URL=http://localhost:3000

# セッション Cookie の署名に使うランダムな文字列(openssl rand -hex 32 などで生成)
SESSION_SECRET=change-me-to-a-long-random-string
