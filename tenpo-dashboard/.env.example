# ===== 動作モード =====
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY が未設定の場合は
# デモデータ(モックモード)で動作します。

# Supabase(本番運用時に設定)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# セッション Cookie の署名キー(ランダムな長い文字列を設定)
AUTH_SECRET=

# 本部管理画面のログインパスワード
ADMIN_PASSWORD=

# GAS からの同期 API を保護する共有シークレット
# (スプレッドシート側の GAS スクリプトプロパティにも同じ値を設定)
GAS_SYNC_SECRET=

# 既存の衛生管理アプリの URL(ダッシュボードから開くリンク)
NEXT_PUBLIC_HYGIENE_APP_URL=
