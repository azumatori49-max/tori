# ===== 動作モード =====
# Firebase の認証情報が未設定の場合はデモデータ(モックモード)で動作します。

# --- Firebase(本番運用時にいずれかの方法で設定)---
# 方法 1: サービスアカウント JSON をそのまま 1 行で設定
FIREBASE_SERVICE_ACCOUNT=

# 方法 2: 個別に設定(JSON から抜き出した値。private_key の改行は \n のままで可)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 方法 3: Firebase App Hosting / Cloud Run 上では自動認証されるため、
#         上記をすべて空にして GOOGLE_APPLICATION_CREDENTIALS も未設定で動作します。
#         (その場合の切り替え用に GOOGLE_APPLICATION_CREDENTIALS も認識します)

# セッション Cookie の署名キー(ランダムな長い文字列を設定)
AUTH_SECRET=

# 本部管理画面のログインパスワード
ADMIN_PASSWORD=

# GAS からの同期 API を保護する共有シークレット
# (スプレッドシート側の GAS スクリプトプロパティにも同じ値を設定)
GAS_SYNC_SECRET=

# 既存の衛生管理アプリの URL(ダッシュボードから開くリンク)
# 未設定時は https://toriyaro-eisei-faf2e.web.app
NEXT_PUBLIC_HYGIENE_APP_URL=

# 既存の衛生管理アプリの Realtime Database URL(提出状況のリアルタイム同期)
# 未設定時は https://toriyaro-eisei-faf2e-default-rtdb.firebaseio.com
# 「off」を設定すると同期を無効化(スプレッドシート経由の値を使用)
HYGIENE_RTDB_URL=
