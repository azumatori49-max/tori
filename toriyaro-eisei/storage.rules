rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 写真パス: photos/{storeKey}/{type}/{key}/{filename}
    match /photos/{storeKey}/{type}/{key}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && storeKey.matches('^store_[a-z0-9]{8}$')
        && (type == 'daily' || type == 'weekly' || type == 'monthly')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // 90日経過後の自動クリーンアップ用
      allow delete: if request.auth != null;
    }
    // ご意見のスクリーンショット添付用
    match /feedback/{storeKey}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    // 紹介手当申請の手書きサイン画像（manager / referrer / referred）
    match /referral-signs/{requestId}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}