rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 写真パス: photos/{storeKey}/{type}/{key}/{filename}
    match /photos/{storeKey}/{type}/{key}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && storeKey.matches('^store_[a-z0-9]{8}$')
        && (type == 'daily' || type == 'weekly' || type == 'monthly')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // 90日経過後の自動クリーンアップ用
      allow delete: if request.auth != null;
    }
    // ご意見のスクリーンショット添付用
    match /feedback/{storeKey}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    // 紹介手当申請の手書きサイン画像（manager / referrer / referred）
    match /referral-signs/{requestId}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && request.resource.size < 1 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    // 年間スケジュールの動画提出: videos/{storeKey}/{type}/{key}/{filename}（1本 500MB まで）
    // 自動クリーンアップ（cleanup.ts）はこのパスを対象にしていない
    match /videos/{storeKey}/{type}/{key}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && storeKey.matches('^store_[a-z0-9]{8}$')
        && (type == 'daily' || type == 'weekly' || type == 'monthly')
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null;
    }
    // 年間スケジュールの参考動画（管理画面からアップロード。1本 100MB 未満、動画のみ）
    match /schedule-media/{scheduleId}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null;
    }
    // 年間スケジュールの項目に付ける参考画像（管理画面からアップロード）
    match /schedule-refs/{scheduleId}/{filename} {
      allow read: if request.auth != null;
      allow create, update:
        if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}