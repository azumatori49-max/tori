rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 写真パス: photos/{storeKey}/{type}/{key}/{filename}
    match /photos/{storeKey}/{type}/{key}/{filename} {
      allow read: if true;
      allow create, update:
        if storeKey.matches('^store_[a-z0-9]{8}$')
        && (type == 'daily' || type == 'weekly')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      // 90日経過後の自動クリーンアップ用
      allow delete: if true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
